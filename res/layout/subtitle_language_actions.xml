<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subtitle_language_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <Button
        android:id="@+id/subtitle_languages"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white" android:background="@drawable/transparent_ripple"
        android:visibility="gone"
        android:text="@string/subtitle_languages_identify" />
    <Button
        android:id="@+id/subtitle_language_cancel"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white" android:background="@drawable/transparent_ripple"
        android:visibility="gone"
        android:text="@string/subtitle_languages_cancel" />
    <Button
        android:id="@+id/subtitle_language_save"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white" android:background="@drawable/transparent_ripple"
        android:visibility="gone"
        android:text="@string/subtitle_languages_save" />
    <Button
        android:id="@+id/subtitle_language_restore"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white" android:background="@drawable/transparent_ripple"
        android:visibility="gone"
        android:text="@string/subtitle_languages_restore" />
</LinearLayout>
