<?xml version="1.0" encoding="utf-8"?>

<com.archos.mediacenter.video.player.tvmenu.AudioDelayTVPicker
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audioDelayPicker"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"  >

    <RelativeLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="20dp" >

        <ImageView
            android:id="@+id/image_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dip"
            android:layout_alignParentStart="true"
            android:padding="4dip"
            app:srcCompat="@drawable/arrow_left"
        android:contentDescription="@null" />

        <TextView
            android:id="@+id/text_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/image_previous"
            android:layout_toStartOf="@id/image_next"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_centerInParent="true"
            android:textColor="#ffffff"
            android:textSize="@dimen/tv_menu_font_size"
            style="@style/textAppearanceLarge" />

        <ImageView
            android:id="@+id/image_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dip"
            android:layout_alignParentEnd="true"
            android:padding="4dip"
            app:srcCompat="@drawable/arrow_right"
        android:contentDescription="@null" />

    </RelativeLayout>

</com.archos.mediacenter.video.player.tvmenu.AudioDelayTVPicker>
