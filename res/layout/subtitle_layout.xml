<?xml version="1.0" encoding="utf-8"?>

<!--
  subtitle_layout.xml

  This container is still load-bearing: SubtitleManager attaches it to the player view
  tree purely for its window-inset / rotation / system-UI-visibility tracking (see
  attachWindow()/adjustView() in SubtitleManager.java, which read mRootView and
  mSubtitleLayout regardless of subtitle content). It no longer contains any actual
  subtitle rendering views — SubtitleGfxView and Subtitle3DTextView were removed once
  the native libass/GL SubtitleEngine took over all rendering (2D direct GL draw or the
  3D hybrid CPU-blit bridge), and nothing in the codebase references either type anymore.

  The one child that remains, subtitle_spacer, is now purely a position-hint indicator:
  a translucent bar shown briefly while the user drags the vertical-offset control, so
  they can see where the bottom margin will land before releasing. It plays no role in
  actual subtitle rendering (that's owned entirely by libass's MarginV, applied natively).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/subtitle_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

    <com.archos.mediacenter.video.player.SubtitleSpacerView android:id="@+id/subtitle_spacer"
        android:layout_width="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_height="@dimen/subtitles_paddingBottom"
        android:visibility="visible"
    />

</RelativeLayout>
