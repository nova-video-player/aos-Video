<?xml version="1.0" encoding="utf-8"?>
<com.archos.mediacenter.video.player.tvmenu.TVMenuItem xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/test"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="1dp" >

    <RadioButton
        android:id="@+id/info_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@null"
        android:buttonTint="#ffedffff"
        android:ellipsize="marquee"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#ffffff"
        android:textSize="@dimen/tv_menu_font_size"
        android:text="test"
        tools:ignore="HardcodedText" />

</com.archos.mediacenter.video.player.tvmenu.TVMenuItem>