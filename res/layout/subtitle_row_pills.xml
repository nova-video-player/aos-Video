<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented choice. Segments (subtitle_row_pill_segment) are added by code; the chosen one is setSelected(true).
     One focus stop: on TV Left/Right moves the selection, on touch each segment is tappable. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SubtitlePanel.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/sp_label"
        style="@style/SubtitlePanel.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/sp_pills"
        style="@style/SubtitlePanel.PillGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
</LinearLayout>
