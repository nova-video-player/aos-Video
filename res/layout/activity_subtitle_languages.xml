<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/subtitle_language_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/subtitle_language_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:titleTextAppearance="@style/ToolbarTitle" />

    <ScrollView
        android:id="@+id/subtitle_language_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/info_activity_horizontal_margin"
            android:paddingEnd="@dimen/info_activity_horizontal_margin"
            android:paddingTop="@dimen/video_info_margin_half"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/video_info_margin_half">
                    <TextView
                        android:id="@+id/subtitle_language_status"
                        style="@style/VideoInfoFileInfo"
                        android:layout_width="match_parent"
                        android:padding="@dimen/video_info_margin_half"
                        android:accessibilityLiveRegion="polite" />
                    <ProgressBar
                        android:id="@+id/subtitle_language_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true" />
                    <Button
                        android:id="@+id/subtitle_language_analyze"
                        style="@style/SubtitleLanguageAction"
                        android:text="@string/subtitle_languages_identify" />
                    <Button
                        android:id="@+id/subtitle_language_cancel"
                        style="@style/SubtitleLanguageAction"
                        android:visibility="gone"
                        android:text="@string/subtitle_languages_cancel" />
                    <TextView
                        android:id="@+id/subtitle_language_save_hint"
                        style="@style/VideoInfoFileInfo"
                        android:layout_width="match_parent"
                        android:padding="@dimen/video_info_margin_half"
                        android:visibility="gone"
                        android:text="@string/subtitle_languages_save_hint" />
                    <Button
                        android:id="@+id/subtitle_language_save"
                        style="@style/SubtitleLanguageAction"
                        android:visibility="gone"
                        android:text="@string/subtitle_languages_save" />
                    <Button
                        android:id="@+id/subtitle_language_restore"
                        style="@style/SubtitleLanguageAction"
                        android:visibility="gone"
                        android:text="@string/subtitle_languages_restore" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/video_info_cardview_top_margin"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/VideoInfoFileInfo.CardViewTitle"
                        android:text="@string/info_subtitle" />
                    <LinearLayout
                        android:id="@+id/subtitle_language_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/video_info_margin_half" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
