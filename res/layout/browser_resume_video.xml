<?xml version="1.0" encoding="utf-8"?>
<!-- This is the resume view of the video browser for getting fast
access to last video played. -->
<com.archos.mediacenter.utils.GlobalResumeView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/global_resume"
    android:layout_width="match_parent"
    android:layout_height="@dimen/global_resume_video_height"
    android:focusable="true">

    <include layout="@layout/nowplaying_header" />

    <ImageView
        android:id="@+id/global_resume_focus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/global_resume_focus_bg"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/global_resume_btn"
        android:layout_width="35dp"
        android:layout_height="32dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/global_resume_icon_padding_left"
        android:layout_marginEnd="@dimen/global_resume_icon_padding_right"
        app:srcCompat="@drawable/resume_icon"/>

    <TextView
        android:id="@+id/global_resume_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/global_resume_btn"
        android:text="Mad Max Fury Road"
        android:textSize="20sp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:paddingTop="2dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:fontFamily="@font/nhaasgroteskdspro_75bd"
        android:textColor="@color/white_font"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:background="@drawable/rounded_background"/>

    <!-- Custom resume button -->
    <LinearLayout
        android:id="@+id/resume_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="end"
        android:paddingEnd="1dp"
        android:paddingStart="1dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:clickable="true"
        android:focusable="true">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">

            <!-- Text and Icon Container -->
            <LinearLayout
                android:id="@+id/resume_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Resume Text -->
                <TextView
                    android:id="@+id/resume_text"
                    android:text="@string/resume"
                    android:textColor="@color/resume_text_tint"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:layout_marginTop="-1dp"
                    android:shadowColor="#AA000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textAllCaps="true"
                    android:textSize="17sp"
                    android:fontFamily="@font/nhaasgroteskdspro_65md"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <!-- Timestamp Text -->
                <TextView
                    android:id="@+id/timestamp_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="00:00"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/nhaasgroteskdspro_75bd"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:shadowColor="#AA000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"/>
            </LinearLayout>

            <!-- Icon -->
            <ImageView
                android:id="@+id/resume_icon"
                android:layout_gravity="center"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:scaleType="centerInside"
                android:layout_alignBaseline="@id/resume_container"
                android:layout_toEndOf="@+id/resume_container"
                android:src="@drawable/resume_icon"
                app:tint="@color/play_button_tint"
                app:tintMode="src_atop"/>
        </RelativeLayout>
    </LinearLayout>
</com.archos.mediacenter.utils.GlobalResumeView>
