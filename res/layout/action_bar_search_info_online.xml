<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/search_info_online_ripple"
    android:paddingLeft="4dip"
    android:paddingRight="4dip"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="32dip"
        android:fontFamily="@font/nhaasgroteskdspro_95blk"
        android:textSize="18sp"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="@string/start_auto_scraper_activity"
        style="@android:style/TextAppearance.Holo.Widget.ActionBar.Menu"
        android:textColor="@color/white" />
</LinearLayout>
