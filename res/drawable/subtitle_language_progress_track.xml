<?xml version="1.0" encoding="utf-8"?>
<!-- Fill the entire 4dp viewport; platform progress drawables include vertical insets. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="4dp"
    android:viewportWidth="100"
    android:viewportHeight="4">
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.2"
        android:pathData="M0,0 H100 V4 H0 Z" />
    <group android:name="scan">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,0 H25 V4 H0 Z" />
    </group>
</vector>
