<lint>
    <!--
      Third-party network libraries (Bouncy Castle, Commons Net, Jetty) bundle
      trust-all managers for optional self-signed certificate handling in local
      network protocols (FTPS, WebDAV, UPnP).
      Ignore warnings originating from compiled JAR dependencies while keeping the
      check active for first-party application source code.
    -->
    <issue id="TrustAllX509TrustManager">
        <ignore path="**/*.jar" />
    </issue>
</lint>
